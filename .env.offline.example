# HKD Smart offline/LAN profile — SQLite, no platform SaaS admin.
# Copy this file to .env before running docker-compose.offline.yml.

COMPOSE_PROJECT_NAME=tdpos-offline
WEB_HTTP_PORT=6687
WEB_HTTPS_PORT=6688

OFFLINE_MODE=true
DATABASE_PROVIDER=sqlite
DATABASE_MODE=shared
ENABLE_PLATFORM_ADMIN=false

# Leave secrets empty on first start to generate them in the data volume,
# or set unique values for a controlled installation.
JWT_SECRET=
HKDPLUS_INSTANCE_SECRET=
HKDPLUS_INSTANCE_ID=
HKDPLUS_SETUP_TOKEN=

# hkdsmart.local is advertised on the LAN with mDNS/Bonjour.
# The installer must advertise this name from the offline server.
HKDPLUS_HOSTNAME=hkdsmart.local
HKDPLUS_PUBLIC_URL=https://hkdsmart.local:6688
CORS_ORIGINS=http://hkdsmart.local:6687,https://hkdsmart.local:6688,http://localhost:6687,https://localhost:6688,http://127.0.0.1:6687,https://127.0.0.1:6688

# Print Bridge chạy trên máy chủ offline; token phải trùng bridge.env.
VITE_PRINT_BRIDGE_URL=/print-bridge
VITE_PRINT_BRIDGE_TOKEN=
