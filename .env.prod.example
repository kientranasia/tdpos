# Keep this value as `tdpos` when upgrading the existing deployment so Docker
# reuses tdpos_tdpos_data. Change it only after an explicit volume migration.
COMPOSE_PROJECT_NAME=tdpos
HKDPLUS_HOSTNAME=hkdsmart.trandao.vn
# Host port consumed by the Cloudflare Tunnel origin service.
WEB_HTTP_PORT=6666
OFFLINE_MODE=false
DATABASE_MODE=per_tenant
ENABLE_PLATFORM_ADMIN=true
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=HKD Smart Platform
ADMIN_BOOTSTRAP_ROLE=super_admin
# Generate unique values per customer, or leave empty for first start generation.
JWT_SECRET=
HKDPLUS_INSTANCE_SECRET=
HKDPLUS_SETUP_TOKEN=
HKDPLUS_PUBLIC_URL=https://hkdsmart.trandao.vn
CORS_ORIGINS=https://hkdsmart.trandao.vn
