FROM node:22-slim

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

RUN mkdir -p /app/data && chown -R node:node /app

ENV NODE_ENV=production
ENV API_PORT=3101

USER node

EXPOSE 3101

# Schema changes are applied by Drizzle before the idempotent seed. The
# PostgreSQL branch is intentionally a separate image from the offline image.
CMD ["sh", "-c", "npm run pg:migrate && npm run init && npm run server"]
