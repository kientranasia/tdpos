# Canonical online SaaS profile: PostgreSQL + Cloudflare Tunnel.
# Copy to .env and replace all placeholders before deployment.
COMPOSE_PROJECT_NAME=tdpos-saas-pg
WEB_HTTP_PORT=6666

POSTGRES_DB=tdpos_saas
POSTGRES_USER=tdpos
POSTGRES_PASSWORD=__REPLACE_WITH_LONG_RANDOM_PASSWORD__

OFFLINE_MODE=false
DATABASE_PROVIDER=postgres
DATABASE_MODE=shared
ENABLE_PLATFORM_ADMIN=true
ADMIN_BOOTSTRAP_EMAIL=platform-admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=__REPLACE_WITH_LONG_RANDOM_PASSWORD__
ADMIN_BOOTSTRAP_NAME=HKD Smart Platform
ADMIN_BOOTSTRAP_ROLE=super_admin

JWT_SECRET=__REPLACE_WITH_LONG_RANDOM_SECRET__
HKDPLUS_INSTANCE_SECRET=__REPLACE_WITH_LONG_RANDOM_SECRET__
HKDPLUS_SETUP_TOKEN=__REPLACE_WITH_LONG_RANDOM_SECRET__

# Replace this with the separate Cloudflare hostname for this branch.
HKDPLUS_HOSTNAME=hkdsmart-pg.trandao.vn
HKDPLUS_PUBLIC_URL=https://hkdsmart-pg.trandao.vn
CORS_ORIGINS=https://hkdsmart-pg.trandao.vn
