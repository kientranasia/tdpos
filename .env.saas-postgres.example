# Separate PostgreSQL SaaS deployment. Do not reuse the SQLite production
# Compose project, volume, host port, or Cloudflare origin.
COMPOSE_PROJECT_NAME=tdpos-saas-pg
WEB_HTTP_PORT=6666

POSTGRES_DB=tdpos_saas
POSTGRES_USER=tdpos
POSTGRES_PASSWORD=replace-with-a-long-random-password

OFFLINE_MODE=false
DATABASE_PROVIDER=postgres
DATABASE_MODE=shared
ENABLE_PLATFORM_ADMIN=true
ADMIN_BOOTSTRAP_EMAIL=platform-admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-password
ADMIN_BOOTSTRAP_NAME=HKD Smart Platform
ADMIN_BOOTSTRAP_ROLE=super_admin

JWT_SECRET=replace-with-a-long-random-secret
HKDPLUS_INSTANCE_SECRET=replace-with-a-long-random-secret
HKDPLUS_SETUP_TOKEN=replace-with-a-long-random-setup-token

# Replace this with the separate Cloudflare hostname for this branch.
HKDPLUS_HOSTNAME=hkdsmart-pg.trandao.vn
HKDPLUS_PUBLIC_URL=https://hkdsmart-pg.trandao.vn
CORS_ORIGINS=https://hkdsmart-pg.trandao.vn
