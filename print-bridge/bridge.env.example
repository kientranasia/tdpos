# Print Bridge chạy trên máy chủ offline.
PRINT_BRIDGE_HOST=0.0.0.0
PRINT_BRIDGE_PORT=17650
PRINT_BRIDGE_TOKEN=thay-token-print-bridge
PRINT_BRIDGE_ALLOWED_ORIGINS=*

# network = máy in nhiệt có IP và hỗ trợ raw TCP/9100
# windows = máy in đã cài trong Windows, in raw qua Windows spooler
PRINT_BRIDGE_PRINTER_MODE=network
PRINT_BRIDGE_PRINTER_HOST=192.168.1.80
PRINT_BRIDGE_PRINTER_PORT=9100
PRINT_BRIDGE_PRINTER_NAME=
PRINT_BRIDGE_PAPER_WIDTH=42
# ascii tương thích rộng; utf8 chỉ dùng nếu máy in hỗ trợ UTF-8.
PRINT_BRIDGE_ENCODING=ascii
