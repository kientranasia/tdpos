# Online SaaS UAT profile. Use with docker-compose.yml and
# docker-compose.uat.yml.
COMPOSE_PROJECT_NAME=tdpos-saas-pg-uat
WEB_HTTP_PORT=16666

OFFLINE_MODE=false
DATABASE_PROVIDER=postgres
DATABASE_MODE=shared
ENABLE_PLATFORM_ADMIN=true

POSTGRES_DB=tdpos_saas_uat
POSTGRES_USER=tdpos
POSTGRES_PASSWORD=__REPLACE_WITH_LONG_RANDOM_PASSWORD__

ADMIN_BOOTSTRAP_EMAIL=platform-admin-uat@example.com
ADMIN_BOOTSTRAP_PASSWORD=__REPLACE_WITH_LONG_RANDOM_PASSWORD__
ADMIN_BOOTSTRAP_NAME=HKD Smart Platform UAT
ADMIN_BOOTSTRAP_ROLE=super_admin

JWT_SECRET=__REPLACE_WITH_LONG_RANDOM_SECRET__
HKDPLUS_INSTANCE_SECRET=__REPLACE_WITH_LONG_RANDOM_SECRET__
HKDPLUS_SETUP_TOKEN=__REPLACE_WITH_LONG_RANDOM_SECRET__

HKDPLUS_HOSTNAME=hkdsmart-pg-uat.trandao.vn
HKDPLUS_PUBLIC_URL=https://hkdsmart-pg-uat.trandao.vn
CORS_ORIGINS=https://hkdsmart-pg-uat.trandao.vn
