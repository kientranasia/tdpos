# Example Dockerfile for Node.js React Application
# This is a template to help you deploy your application.

# Use a multi-stage build to keep the final image small
# --- STAGE 1: Build the React Application ---
FROM node:20-slim AS build

WORKDIR /app

# Copy package files and install dependencies
COPY package*.json ./
RUN npm install

# Copy the rest of the application code
COPY . .

# Build the application
# Note: Ensure your build script outputs to the 'dist' directory
RUN npm run build

# --- STAGE 2: Serve the Static Files ---
# Options for Stage 2:
# 1. Use Nginx (Standard and Recommended for Production)
# 2. Use a simple Node static server (Quick but less performant)

# OPTION 1: NGINX (Recommended)
FROM nginx:alpine

# Copy the build artifacts from the previous stage
COPY --from=build /app/dist /usr/share/nginx/html

# Replace with your custom Nginx configuration if needed
# COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

# --- ALTERNATIVE: Quick Node server (if you don't want to use Nginx) ---
# FROM node:20-slim
# WORKDIR /app
# RUN npm install -g serve
# COPY --from=build /app/dist ./dist
# EXPOSE 3000
# CMD ["serve", "-s", "dist", "-l", "3000"]
