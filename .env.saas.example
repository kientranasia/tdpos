COMPOSE_PROJECT_NAME=tdpos-saas

# Online SaaS mode: public registration is disabled. Tenants are created by
# the platform admin and owners are provisioned manually.
OFFLINE_MODE=false
ENABLE_PLATFORM_ADMIN=true

# Cloudflare hostname is environment configuration, not application logic.
HKDPLUS_HOSTNAME=hkdsmart.trandao.vn
WEB_HTTP_PORT=4534
HKDPLUS_PUBLIC_URL=https://hkdsmart.trandao.vn
CORS_ORIGINS=https://hkdsmart.trandao.vn

# Set unique random values in the real .env file. Never commit that file.
JWT_SECRET=
HKDPLUS_INSTANCE_SECRET=
HKDPLUS_SETUP_TOKEN=

# Used once to create the platform admin when the admin table is empty.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=HKD Smart Platform
ADMIN_BOOTSTRAP_ROLE=super_admin
