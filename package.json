    "test:operations": "node scripts/hkdplus-operations-smoke.mjs",
    "test:permissions": "node scripts/hkdplus-permissions-smoke.mjs",
    "test:tenant-isolation": "node scripts/hkdplus-tenant-isolation-smoke.mjs",
    "test:tenant-isolation-postgres": "node scripts/hkdplus-postgres-tenant-isolation-smoke.mjs",
    "test:lifecycle": "node scripts/hkdcare-lifecycle-smoke.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
