# HKD Smart online SaaS — PostgreSQL + Cloudflare Tunnel
# Copy this file to .env, replace every placeholder, then run:
#   docker compose up -d --build
#
# Public HTTPS is terminated by Cloudflare. The gateway only listens on
# WEB_HTTP_PORT on localhost for the Cloudflare Tunnel origin.

COMPOSE_PROJECT_NAME=tdpos-saas-pg
WEB_HTTP_PORT=6666

OFFLINE_MODE=false
DATABASE_PROVIDER=postgres
DATABASE_MODE=shared
ENABLE_PLATFORM_ADMIN=true

POSTGRES_DB=tdpos_saas
POSTGRES_USER=tdpos
POSTGRES_PASSWORD=__REPLACE_WITH_LONG_RANDOM_PASSWORD__

# The first startup creates the platform admin when the admin table is empty.
# Remove ADMIN_BOOTSTRAP_PASSWORD after the first successful bootstrap.
ADMIN_BOOTSTRAP_EMAIL=platform-admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=__REPLACE_WITH_LONG_RANDOM_PASSWORD__
ADMIN_BOOTSTRAP_NAME=HKD Smart Platform
ADMIN_BOOTSTRAP_ROLE=super_admin

# Generate unique values, for example with: openssl rand -base64 48
JWT_SECRET=__REPLACE_WITH_LONG_RANDOM_SECRET__
HKDPLUS_INSTANCE_SECRET=__REPLACE_WITH_LONG_RANDOM_SECRET__
HKDPLUS_SETUP_TOKEN=__REPLACE_WITH_LONG_RANDOM_SECRET__

# Replace these with the hostname configured in Cloudflare Tunnel.
HKDPLUS_HOSTNAME=hkdsmart-pg.trandao.vn
HKDPLUS_PUBLIC_URL=https://hkdsmart-pg.trandao.vn
CORS_ORIGINS=https://hkdsmart-pg.trandao.vn

# Used by local Vite development. The Docker web image uses /api.
VITE_API_URL=http://localhost:3101

# Optional integrations.
GEMINI_API_KEY=
HKDPLUS_LICENSE_PUBLIC_KEY=
HKDPLUS_LICENSE_SERVER_URL=
